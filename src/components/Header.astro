---
import { site, nav, socials } from '../data/site';
import Icon from './icons/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const externalSocials = socials.filter((social) => social.href.startsWith('http'));
---

<header
  class="sticky top-0 z-50 border-b border-zinc-200/60 bg-zinc-50/80 backdrop-blur-md dark:border-zinc-800/60 dark:bg-zinc-950/80"
>
  <div class="container-page">
    <div class="flex h-16 items-center justify-between gap-4">
      <a
        href="#inicio"
        class="group flex items-center gap-2.5 font-semibold tracking-tight"
      >
        <span
          class="grid size-8 place-items-center rounded-lg bg-accent-500 font-mono text-sm font-bold text-white transition-transform group-hover:scale-105"
          aria-hidden="true"
        >
          {site.name.charAt(0)}
        </span>
        <span>{site.shortName}</span>
      </a>

      <nav aria-label="Navegación principal" class="hidden md:block">
        <ul class="flex items-center gap-1">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-600 transition-colors hover:bg-zinc-200/70 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-0.5">
        {
          externalSocials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg p-2 text-zinc-600 transition-colors hover:bg-zinc-200/70 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
            >
              <Icon name={social.icon} />
              <span class="sr-only">{social.label} (se abre en una pestaña nueva)</span>
            </a>
          ))
        }

        <ThemeToggle />

        <button
          id="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="menu-movil"
          aria-label="Abrir menú"
          class="group rounded-lg p-2 text-zinc-600 transition-colors hover:bg-zinc-200/70 hover:text-zinc-900 md:hidden dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
        >
          <Icon name="menu" class="size-5 group-aria-expanded:hidden" />
          <Icon name="x" class="hidden size-5 group-aria-expanded:block" />
        </button>
      </div>
    </div>
  </div>

  <div
    id="menu-movil"
    hidden
    class="border-t border-zinc-200/60 md:hidden dark:border-zinc-800/60"
  >
    <nav aria-label="Navegación principal" class="container-page py-4">
      <ul class="flex flex-col gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-lg px-3 py-2.5 font-medium text-zinc-700 transition-colors hover:bg-zinc-200/70 dark:text-zinc-300 dark:hover:bg-zinc-800"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-movil');

  let open = false;

  const setOpen = (next: boolean) => {
    open = next;
    if (menu) menu.hidden = !open;
    if (!toggle) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };

  toggle?.addEventListener('click', () => setOpen(!open));

  // Al navegar a una sección, el menú se cierra solo.
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !open) return;
    setOpen(false);
    toggle?.focus();
  });
</script>
