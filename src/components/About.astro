---
import Section from './Section.astro';
import Icon from './icons/Icon.astro';

const principles = [
  {
    icon: 'code' as const,
    title: 'Código mantenible',
    text: 'Prefiero soluciones simples y legibles antes que arquitecturas imposibles de mantener.',
  },
  {
    icon: 'terminal' as const,
    title: 'Resolver problemas',
    text: 'Me encierro en cada error hasta entender del todo por qué ocurre.',
  },
  {
    icon: 'sparkles' as const,
    title: 'Aprender siempre',
    text: 'Cada proyecto es una excusa para sumar una tecnología nueva.',
  },
];
---

<Section id="sobre-mi" eyebrow="Sobre mí" title="Desarrollo software que resuelve problemas reales">
  <div class="grid gap-10 lg:grid-cols-5 lg:gap-16">
    <div class="space-y-5 lg:col-span-3">
      <p class="text-base leading-relaxed text-zinc-700 sm:text-lg dark:text-zinc-300">
        Me apasiona el desarrollo de software porque es donde las ideas se vuelven algo que
        la gente puede usar de verdad. Me enriquece el punto donde un reto técnico se vuelve
        difuso: entender el problema, descomponerlo y construir una solución que aguante el
        paso del tiempo.
      </p>
      <p class="text-base leading-relaxed text-zinc-700 sm:text-lg dark:text-zinc-300">
        Trabajo de principio a fin: desde el modelo de datos y la API hasta la interfaz y el
        despliegue. Eso me permite asumir responsabilidad por el resultado completo en lugar
        de entregar piezas sueltas, y me obliga a mantener la coherencia técnica en todo el
        proyecto.
      </p>
      <p class="text-base leading-relaxed text-zinc-700 sm:text-lg dark:text-zinc-300">
        No doy por sentado que un stack es mejor que otro: elijo la tecnología que encaja con
        el problema. Y mantengo el hábito de documentar, medir y aprender de cada entrega.
      </p>
    </div>

    <ul class="space-y-4 lg:col-span-2">
      {
        principles.map((principle) => (
          <li class="rounded-xl border border-zinc-200 bg-white/60 p-5 transition-colors hover:border-accent-500/40 dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-accent-500/40">
            <div class="flex items-center gap-3">
              <span
                class="grid size-9 shrink-0 place-items-center rounded-lg bg-accent-500/10 text-accent-500"
                aria-hidden="true"
              >
                <Icon name={principle.icon} class="size-5" />
              </span>
              <h3 class="font-semibold">{principle.title}</h3>
            </div>
            <p class="mt-2.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {principle.text}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
