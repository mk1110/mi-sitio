---
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import Icon from './icons/Icon.astro';
import { projects, socials } from '../data/site';

const githubUrl = socials.find((social) => social.icon === 'github')?.href;
---

<Section
  id="proyectos"
  eyebrow="Proyectos"
  title="Proyectos destacados"
  description="Dos sitios que he construido y que están en producción."
>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>

  {
    githubUrl && (
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group mt-8 inline-flex items-center gap-2 text-sm font-medium text-zinc-600 transition-colors hover:text-accent-500 dark:text-zinc-400 dark:hover:text-accent-400"
      >
        Ver todos los repositorios
        <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
        <span class="sr-only">(se abre en una pestaña nueva)</span>
      </a>
    )
  }
</Section>
