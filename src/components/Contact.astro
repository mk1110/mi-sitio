---
import Section from './Section.astro';
import Icon from './icons/Icon.astro';
import { socials, contact } from '../data/site';
---

<Section
  id="contacto"
  eyebrow="Contacto"
  title="¿Hablamos?"
  description="Si tienes un proyecto en mente, una duda o simplemente quieres saludar, escríbeme. Respondo siempre."
>
  <div
    class="relative overflow-hidden rounded-2xl border border-zinc-200 bg-white/60 p-8 sm:p-12 dark:border-zinc-800 dark:bg-zinc-900/40"
  >
    <div
      class="pointer-events-none absolute -top-24 -right-24 size-64 rounded-full bg-accent-500/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-xl">
        <p class="text-lg font-medium text-zinc-900 sm:text-xl dark:text-zinc-100">
          Cuéntame qué quieres construir y lo construimos juntos.
        </p>
        <a
          href={contact.href}
          target={contact.href.startsWith('http') ? '_blank' : undefined}
          rel={contact.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="mt-2 inline-block font-mono text-sm text-accent-500 hover:text-accent-400 sm:text-base"
        >
          {contact.detail}
        </a>
      </div>

      <a
        href={contact.href}
        target={contact.href.startsWith('http') ? '_blank' : undefined}
        rel={contact.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-accent-500 px-5 py-3 font-semibold text-white shadow-lg shadow-accent-500/25 transition-all hover:-translate-y-0.5 hover:bg-accent-600 hover:shadow-accent-500/40"
      >
        {contact.label}
        <Icon name={contact.icon} class="size-4" />
      </a>
    </div>

    <ul class="relative mt-10 flex flex-wrap gap-3 border-t border-zinc-200/70 pt-8 dark:border-zinc-800">
      {
        socials.map((social) => (
          <li>
            <a
              href={social.href}
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white/60 px-4 py-2 text-sm font-medium text-zinc-700 transition-all hover:-translate-y-0.5 hover:border-accent-500/50 hover:text-accent-500 dark:border-zinc-800 dark:bg-zinc-800/40 dark:text-zinc-300 dark:hover:border-accent-500/50 dark:hover:text-accent-400"
            >
              <Icon name={social.icon} class="size-4" />
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
