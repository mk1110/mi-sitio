---
import { site, contact } from '../data/site';
import Icon from './icons/Icon.astro';
---

<section id="inicio" class="relative scroll-mt-24 overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="bg-grid absolute inset-0 text-zinc-300/50 dark:text-zinc-800/70"></div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-transparent via-zinc-50/60 to-zinc-50 dark:via-zinc-950/60 dark:to-zinc-950"
    >
    </div>
    <div
      class="absolute top-0 left-1/2 h-72 w-[36rem] -translate-x-1/2 rounded-full bg-accent-500/15 blur-3xl"
    >
    </div>
  </div>

  <div class="container-page">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-zinc-200/80 bg-white/60 px-3 py-1 text-xs font-medium text-zinc-600 backdrop-blur-sm dark:border-zinc-800 dark:bg-zinc-900/60 dark:text-zinc-400"
    >
      <span class="relative flex size-2" aria-hidden="true">
        <span
          class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"
        ></span>
        <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
      </span>
      {site.availability}
    </p>

    <p class="mt-8 text-sm font-medium text-zinc-600 dark:text-zinc-400">
      Hola, soy <span class="font-semibold text-zinc-900 dark:text-zinc-100">{site.name}</span>
    </p>

    <h1
      class="mt-3 max-w-3xl bg-gradient-to-r from-zinc-900 via-zinc-800 to-accent-500 bg-clip-text text-4xl font-extrabold tracking-tight text-transparent sm:text-5xl md:text-6xl dark:from-white dark:via-zinc-200 dark:to-accent-400"
    >
      {site.role}
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-600 sm:text-xl dark:text-zinc-400">
      {site.tagline}
    </p>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a
        href="#proyectos"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent-500 px-5 py-3 font-semibold text-white shadow-lg shadow-accent-500/25 transition-all hover:-translate-y-0.5 hover:bg-accent-600 hover:shadow-accent-500/40"
      >
        Ver proyectos
        <Icon name="arrow-right" class="size-4" />
      </a>
      <a
        href={contact.href}
        target={contact.href.startsWith('http') ? '_blank' : undefined}
        rel={contact.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        class="inline-flex items-center justify-center gap-2 rounded-lg border border-zinc-300 bg-white/60 px-5 py-3 font-semibold text-zinc-900 backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-900/60 dark:text-zinc-100 dark:hover:bg-zinc-800"
      >
        Contactar
        <Icon name={contact.icon} class="size-4" />
      </a>
    </div>

    <p
      class="mt-10 inline-flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-500"
    >
      <Icon name="map-pin" class="size-4" />
      {site.location}
    </p>
  </div>
</section>
