---
interface Props {
  /** Ancla usada por el navbar: #sobre-mi, #proyectos, ... */
  id: string;
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
}

const { id, eyebrow, title, description, class: className } = Astro.props;

const headingId = `${id}-titulo`;
---

<section id={id} aria-labelledby={headingId} class:list={['py-20 sm:py-28', className]}>
  <div class="container-page">
    <div class="mb-10 max-w-2xl sm:mb-14">
      {
        eyebrow && (
          <p class="mb-3 flex items-center gap-2 font-mono text-xs tracking-widest text-accent-400 uppercase">
            <span class="h-px w-6 bg-accent-500/60" aria-hidden="true" />
            {eyebrow}
          </p>
        )
      }
      <h2 id={headingId} class="text-3xl font-bold tracking-tight sm:text-4xl">
        {title}
      </h2>
      {
        description && (
          <p class="mt-4 text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-400">
            {description}
          </p>
        )
      }
    </div>
    <slot />
  </div>
</section>
