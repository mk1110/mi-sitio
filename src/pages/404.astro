---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe.">
  <main id="contenido" class="grid min-h-dvh place-items-center px-5">
    <div class="text-center">
      <p class="font-mono text-sm tracking-widest text-accent-500 uppercase">Error 404</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">
        Esta página no existe
      </h1>
      <p class="mt-4 text-zinc-600 dark:text-zinc-400">
        Puede que el enlace esté mal escrito o que la página se haya movido.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex items-center gap-2 rounded-lg bg-accent-500 px-5 py-3 font-semibold text-white transition-colors hover:bg-accent-600"
      >
        <Icon name="arrow-right" class="size-4 rotate-180" />
        Volver al inicio
      </a>
    </div>
  </main>
</BaseLayout>
